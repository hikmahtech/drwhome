# Copy to .env.local for local work. Never commit real values.
PORT=3000
# ipinfo.io token for "What is my IP" and "IP lookup". Without it those tools say so.
IPINFO_TOKEN=
# GA4 measurement id for the page tag. Optional.
GA_MEASUREMENT_ID=
# A separate GA4 property for server-side MCP tool-call events, never the website's. Both optional;
# without both nothing is sent.
GA_MCP_MEASUREMENT_ID=
GA_MCP_API_SECRET=
# Secret key for the daily caller-id hash in MCP events. Optional: without it a random key is made
# at boot, so a restart splits that day's count for each caller.
MCP_CALLER_SALT=
