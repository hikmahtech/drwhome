# The web app: site, API and the HTTP MCP endpoint. (The root Dockerfile is the stdio MCP
# server that Glama builds; this one is what koyracloud runs.)
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable pnpm
# Inside the image the lockfile is the trust boundary, so install scripts (esbuild) may run.
RUN pnpm config set dangerouslyAllowAllBuilds true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
# python3: koyracloud renders its healthcheck as a python3 one-liner run inside the container.
# Without it the container starts, fails the check and is killed about a minute later.
RUN apk add --no-cache python3 && corepack enable pnpm \
  && pnpm config set dangerouslyAllowAllBuilds true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/public ./public
COPY src ./src
COPY tsconfig.json ./
USER node
EXPOSE 3000
CMD ["node_modules/.bin/tsx", "src/server.ts"]
